# Copy to /etc/ai-code-review/review.env, chmod 600. Never commit actual values.
GITEA_TOKEN=
REVIEW_MODEL=deepseek-v4-flash
REVIEW_BASE_URL=http://your-internal-ai-gateway:3009/v1
REVIEW_API_KEY=
REVIEW_HERMES_PATH=/opt/hermes
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Oasis large-review budget; used only when mapped in reviewer_env.
REVIEW_TIMEOUT_SECONDS=1200
REVIEW_MAX_TOKENS=16384
