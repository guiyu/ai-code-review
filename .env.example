# Server Configuration
# 服务监听端口
PORT=8080
# 运行模式: debug 或 release
MODE=debug

# AI Configuration
# AI API基础URL (示例为DeepSeek API)
AI_BASE_URL=https://api.deepseek.com
# AI模型名称 (示例为DeepSeek的模型)
AI_MODEL=deepseek-chat
# AI API密钥 (需要从对应平台获取)
AI_API_KEY=your_api_key_here

# Gitea Configuration
# Webhook密钥 (用于验证请求来源)
WEBHOOK_SECRET=your_webhook_secret_here
# Gitea访问令牌 (需要在Gitea中生成)
GITEA_TOKEN=your_gitea_token_here
# Gitea API基础URL (根据实际部署地址修改)
GITEA_BASE_URL=http://localhost:3000/api/v1

# Logging Configuration
# 日志级别: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
# 日志文件路径 (留空则输出到控制台)
# 示例: log/code-review.log
LOG_FILE_PATH=

# 其他可选配置
# 如果使用OpenAI或其他兼容API，可以参考以下配置:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4

# 如果使用阿里通义千问，可以参考以下配置:
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus

# Dingtalk Configuration
# 钉钉机器人Webhook URL (需要在钉钉群中创建机器人获取)
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your_access_token_here